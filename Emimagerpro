name: Build EMI Manager APK

on:
  workflow_dispatch:
  push:
    branches: [main, master]

permissions:
  contents: read

jobs:
  build:
    name: Build Android APK
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.10.2

      - name: Accept Android licenses
        run: yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --licenses || true

      - name: Extract project
        run: |
          if [ ! -f EmiManagerPro.zip ]; then
            echo "ERROR: EmiManagerPro.zip not found in repo root."
            ls -la
            exit 1
          fi
          unzip -q EmiManagerPro.zip -d source
          echo "PROJECT_DIR=source/EmiManager" >> "$GITHUB_ENV"

      - name: Build APK
        run: |
          cd "$PROJECT_DIR"
          gradle --no-daemon assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: EMI-Manager-APK
          path: source/EmiManager/app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
          retention-days: 7
